{
  "name": "at10tion",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "bun build.ts",
    "build:prod": "bun build.ts --prod",
    "dev": "bun build.ts --watch",
    "type-check": "bun tsc --noEmit",
    "test": "bun test tests/",
    "test:e2e": "bun run build && playwright test",
    "test:e2e:ui": "bun run build && playwright test --ui",
    "test:e2e:update": "bun run build && playwright test --update-snapshots",
    "test:extension": "bun run build && bun test.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.1",
    "@types/bun": "^1.3.5",
    "@types/chrome": "latest",
    "puppeteer-core": "^24.34.0",
    "typescript": "latest"
  }
}
