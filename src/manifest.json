{
    "manifest_version": 3,
    "name": "@10tion",
    "version": "1.0.0",
    "description": "Reclaim your attention from endless scrolling. Mindful breaks from short-form content.",
    "permissions": [
        "storage",
        "tabs",
        "alarms",
        "scripting"
    ],
    "optional_host_permissions": [
        "<all_urls>"
    ],
    "host_permissions": [
        "*://*.tiktok.com/*",
        "*://*.youtube.com/*",
        "*://*.instagram.com/*",
        "*://*.facebook.com/*",
        "*://*.x.com/*",
        "*://*.twitter.com/*",
        "*://*.snapchat.com/*",
        "*://*.twitch.tv/*"
    ],
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "content_scripts": [
        {
            "matches": [
                "*://*.tiktok.com/*",
                "*://*.youtube.com/*",
                "*://*.instagram.com/*",
                "*://*.facebook.com/*",
                "*://*.x.com/*",
                "*://*.twitter.com/*",
                "*://*.snapchat.com/*",
                "*://*.twitch.tv/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_end"
        }
    ],
    "action": {
        "default_popup": "popup.html",
        "default_title": "@10tion Status"
    },
    "options_page": "options.html",
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "web_accessible_resources": [
        {
            "resources": [
                "icons/icon128.png",
                "icons/platforms/*.svg",
                "fonts.css",
                "theme.css",
                "styles.css",
                "overlay.css",
                "fonts/*"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ]
}